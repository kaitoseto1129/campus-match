    "10いいねで1時間、この画面のトップに表示されます" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "10 likes to appear at the top of this screen for 1 hour" } } } },
    "10いいねで1時間、探す画面のトップに表示!" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "10 likes to appear at the top of Discover for 1 hour!" } } } },
