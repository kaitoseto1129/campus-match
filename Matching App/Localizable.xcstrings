      "comment" : "A label that shows that the other user is typing. The argument is the name of the other user.",
      "isCommentAutoGenerated" : true
    },
    "%@さんに通話をリクエストしますか?" : {
      "comment" : "A confirmation dialog that lets the user confirm whether to request a call to another user. The argument is the name of the other user.",
      "isCommentAutoGenerated" : true
    },
